# 后端端口（不用 PORT，避免与前端开发服务器冲突）
API_PORT=8788

# 管理后台保存的模型密钥用此密钥加密（≥32 字符随机串）；留空时自动生成 apps/server/data/settings.key
SETTINGS_ENCRYPTION_KEY=

# AI 层（OpenAI 兼容接口）。推荐在“管理后台 → 大模型配置”填写（优先生效）；此处为备用。留空则使用规则引擎兜底。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 安全助手失败时的最大尝试次数（1–3），每次尝试都会写入 ai_invocations
AI_MAX_ATTEMPTS=1
# 每个实验会话最多发起的 AI 导师模型调用次数（超出后由知识库规则作答）
AI_TUTOR_MAX_CALLS=40

# 承诺并发数：超出时排队并提示位置（需按学校服务器压测结果设置）
CONCURRENCY_LIMIT=200

# ---------- 实验空间（ILAB）对接：只在服务器私有配置，不得以 VITE_* 暴露 ----------
# mock：本地模拟平台（默认，无外连）；test：官方测试环境；production：正式环境
ILAB_MODE=mock
# 双开关：只有 ILAB_MODE 与会话环境一致且此项为 true 时才会访问外部地址
ILAB_NETWORK_ENABLED=false

# 官方测试环境（凭据从官方测试页取得，填在服务器上，不提交仓库）
ILAB_TEST_BASE_URL=http://39.105.173.29
ILAB_TEST_APPID=10000
ILAB_TEST_SECRET=
# 正式环境（必须 https 且含 www；学校授权并测试通过后才配置）
ILAB_PRODUCTION_BASE_URL=https://www.ilab-x.com
ILAB_PRODUCTION_APPID=
ILAB_PRODUCTION_SECRET=
ILAB_PRODUCTION_AUTHORIZED=false

# 学校对外 HTTPS 地址（正式入口 = ILAB_PUBLIC_ORIGIN + /ilab/launch）
ILAB_PUBLIC_ORIGIN=http://localhost:5174
ILAB_POST_LAUNCH_PATH=/
# 至少 32 字符的随机串，用于加密保存 ILAB 令牌；重启后须保持不变
ILAB_TOKEN_ENCRYPTION_KEY=
ILAB_HANDOFF_TTL_SECONDS=60

# 待教师/平台确认的口径：未确认前测试/正式回传会被阻断（mock 仅提示）
ILAB_EXPECT_TIME_CONFIG=config/step-expect-time.pending.json
ILAB_SCORE_POLICY=unconfirmed
ILAB_AI_COUNT_POLICY=unconfirmed
ILAB_TIME_EXPORT_POLICY=unconfirmed

# 本地防护：未完成快照默认关闭；每次进入的外部调用预算；附件保守上限
ILAB_INCOMPLETE_UPLOADS_ENABLED=false
ILAB_OUTBOUND_CALL_BUDGET=8
ILAB_MAX_ATTACHMENT_BYTES=5000000

# 真实模型元数据（有真实模型调用时才需要；不知道版本就留空，系统会阻断而不是编造）
ILAB_AI_MODEL_VERSION=
ILAB_AI_DEPLOYMENT=
ILAB_AI_PROVIDER=

# 报告 PDF 中文字体（必须可嵌入）；Linux 安装 fonts-noto-cjk 后可留空自动识别。.ttc 需填 PostScript 名，如 NotoSansCJKsc-Regular
ILAB_REPORT_FONT_PATH=
ILAB_REPORT_FONT_FAMILY=
